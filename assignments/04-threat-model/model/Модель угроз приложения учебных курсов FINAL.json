              "privilegeLevel": "",
              "threats": [
                {
                  "id": "866efec2-1df2-4eef-8868-5752e20e1654",
                  "title": "Внедрение SQL-кода через пользовательский ввод",
                  "status": "Mitigated",
                  "severity": "Medium",
                  "type": "Tampering",
                  "description": "Злоумышленник может ввести фрагмент SQL-кода вместо названия таблицы, столбца или обычного значения, чтобы прочитать либо изменить данные способом, не предусмотренным приложением.",
                  "mitigation": "Проверять названия таблиц и колонок по белому списку TABLES, использовать sql.Identifier для идентификаторов и передавать значения отдельно через параметризованные плейсхолдеры %s.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 3,
                  "score": ""
                },
                {
                  "id": "f327bee5-b55b-4e39-916b-53bc418a7b47",
                  "title": "Исчерпание ресурсов Python-приложения",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Denial of service",
                  "description": "Пользователь может запросить вставку слишком большого количества строк или многократно запускать операции. Это может вызвать чрезмерное потребление процессорного времени и памяти и привести к зависанию приложения.",
                  "mitigation": "Ограничить максимальное количество строк одной операции, ограничить число попыток, использовать connect_timeout и statement_timeout, контролировать потребление ресурсов контейнера.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 4,
                  "score": ""
                },
                {
                  "id": "0d8abad8-40aa-464b-a342-d40e608cef54",
                  "title": "Получение повышенных прав через приложение",
                  "status": "Mitigated",
                  "severity": "High",
                  "type": "Elevation of privilege",
                  "description": "Используя уязвимость приложения или одной из его зависимостей, злоумышленник может выполнить код внутри контейнера и получить доступ к ресурсам с более высокими правами.",
                  "mitigation": "Запускать приложение от непривилегированного пользователя courseapp, не выдавать контейнеру privileged, регулярно обновлять зависимости и предоставлять пользователю только необходимые права.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 5,
                  "score": ""
                }
              ],
