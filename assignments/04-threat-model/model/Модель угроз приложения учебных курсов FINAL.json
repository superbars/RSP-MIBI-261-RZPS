              "type": "tm.Actor",
              "name": "Пользователь",
              "description": "Пользователь интерактивного приложения, вводящий логин, пароль, команды и значения для выполнения операций с базой данных.",
              "isTrustBoundary": false,
              "outOfScope": false,
