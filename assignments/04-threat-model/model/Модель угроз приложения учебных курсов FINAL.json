              "privilegeLevel": "",
              "threats": [
                {
                  "id": "40031803-888c-40cb-a0a7-5089091b048a",
                  "title": "Подмена сервера PostgreSQL",
                  "status": "Open",
                  "severity": "High",
                  "type": "Spoofing",
                  "description": "Злоумышленник, получивший доступ к внутренней сети Docker или настройкам DNS, может попытаться выдать свой сервис за PostgreSQL и получить передаваемые приложением учётные данные и запросы.",
                  "mitigation": "Изолировать внутреннюю сеть Docker, не публиковать порт PostgreSQL наружу, использовать проверку сертификата и TLS при работе в недоверенной сети, ограничить подключение только необходимыми сервисами.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 6,
                  "score": ""
                },
                {
                  "id": "c5b65c21-776f-42e5-95d2-4aede0a32cc6",
                  "title": "Несанкционированное изменение данных через учётную запись приложения",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "Получив логин и пароль роли course_user, злоумышленник может подключиться к PostgreSQL и изменить сведения о преподавателях, курсах, студентах, записях на курсы и оценках в пределах прав этой роли.",
                  "mitigation": "Хранить пароль вне репозитория, регулярно менять учётные данные, не публиковать порт PostgreSQL, применять SCRAM-SHA-256, выдавать минимальные права и вести аудит изменений.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 7,
                  "score": ""
                },
                {
                  "id": "dd57700d-b915-4d94-ab47-b4159da8dc35",
                  "title": "Исчерпание ресурсов PostgreSQL",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Denial of service",
                  "description": "Большое количество одновременных подключений, массовых операций или ресурсоёмких запросов может исчерпать доступные PostgreSQL ресурсы и сделать базу данных недоступной.",
                  "mitigation": "Использовать statement_timeout и connect_timeout, ограничить ресурсы контейнера, настроить максимальное количество подключений, ограничить размер массовых операций и контролировать состояние базы через healthcheck.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 8,
                  "score": ""
                }
              ],
