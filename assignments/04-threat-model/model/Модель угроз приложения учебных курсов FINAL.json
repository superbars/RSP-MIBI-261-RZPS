              "hasOpenThreats": true,
              "providesAuthentication": false,
              "threats": [
                {
                  "id": "0c14c7c0-470e-4e08-ad02-6ae91369be5f",
                  "title": "Подмена пользователя с использованием похищенных учётных данных",
                  "status": "Open",
                  "severity": "High",
                  "type": "Spoofing",
                  "description": "Злоумышленник может получить логин и пароль пользователя course_user и выполнить операции с базой данных от имени легитимного пользователя.",
                  "mitigation": "Использовать уникальные учётные данные, хранить пароль вне исходного кода, применять SCRAM-SHA-256, ограничить права пользователя БД и регулярно менять пароль.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 1,
                  "score": ""
                },
                {
                  "id": "2a72994b-8fad-40aa-b136-24463a1cbf90",
                  "title": "Невозможность установить автора изменений",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Repudiation",
                  "description": "Несколько операторов могут работать под общей учётной записью course_user. Приложение не записывает, кто и когда выполнил операцию, поэтому установить автора изменения по журналу невозможно.",
                  "mitigation": "Использовать отдельные учётные записи, записывать пользователя, тип операции, время и результат выполнения, а также защищать журнал от изменения.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 2,
                  "score": ""
                }
              ],
              "threatFrequency": {
                "spoofing": 1,
                "repudiation": 1
              }
            }
